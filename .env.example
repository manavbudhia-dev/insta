# ---- Your server ----
DOMAIN=insta.zealcoder.in
BASE_URL=https://insta.zealcoder.in

# Password for the dashboard (min 8 characters). Pick a long one.
ADMIN_PASSWORD=

# Random strings. Generate each with:  openssl rand -hex 32
SESSION_SECRET=
WEBHOOK_VERIFY_TOKEN=

# ---- From the Meta App Dashboard: Instagram > API setup with Instagram login ----
IG_APP_ID=
IG_APP_SECRET=

# Optional: the Meta app's own secret (App settings > Basic). Only needed if webhooks
# are rejected with "invalid signature" in the Activity log.
META_APP_SECRET=

# Graph API version to call
GRAPH_VERSION=v27.0
