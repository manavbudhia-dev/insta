# ---- Your server ----
DOMAIN=insta.zealcoder.in
BASE_URL=https://insta.zealcoder.in

# Password for the dashboard (min 8 characters). Pick a long one.
ADMIN_PASSWORD=

# Random strings. Generate each with:  openssl rand -hex 32
# SESSION_SECRET also encrypts the stored Instagram token: changing it later means reconnecting the account.
SESSION_SECRET=
WEBHOOK_VERIFY_TOKEN=

# ---- Meta app (Instagram API with Unified Login) ----
# App settings > Basic. Use the META app ID and secret, not an "Instagram app" ID/secret.
META_APP_ID=
META_APP_SECRET=
# Use cases > Manage messaging & content on Instagram > API setup with Unified login
# > Configure your app: the ID of the login configuration you selected (config_id).
META_CONFIG_ID=

# Graph API version to call
GRAPH_VERSION=v26.0

# Optional: maximum total size of uploaded post media kept on disk, in MB (default 5120)
# MAX_MEDIA_MB=5120
