# Caddy obtains and renews the HTTPS certificate for this domain automatically.
{$DOMAIN} {
	encode gzip
	header -Server
	# Uploads are capped at the app level too; this stops oversized bodies before they reach it.
	request_body {
		max_size 400MB
	}
	# Control API for client instances: private Docker network only.
	respond /internal/* 404
	reverse_proxy app:3000
}

# Client subdomains, written by scripts/client.sh.
import /etc/caddy/clients/*.caddy
